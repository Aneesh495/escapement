! Copyright (C) 2026 Aneesh Krishna.
! Escapement: IEEE 1588-2019 Precision Time Protocol Engine.
! Protocol constants, port definitions, multicast addresses, and clock qualities.

USING: namespaces ;
IN: escapement.common.constants

! UDP Port assignments per IEEE 1588-2019 Annex C
CONSTANT: PTP-EVENT-PORT 319
CONSTANT: PTP-GENERAL-PORT 320

! Default Multicast IPv4 Addresses
CONSTANT: PTP-PRIMARY-MCAST-IP "224.0.1.129"
CONSTANT: PTP-PDELAY-MCAST-IP  "224.0.0.107"

! Ethernet Multicast MAC Addresses
CONSTANT: PTP-PRIMARY-MCAST-MAC "01:1b:19:00:00:00"
CONSTANT: PTP-PDELAY-MCAST-MAC  "01:80:c2:00:00:0e"

! IEEE 1588 Protocol Versions
CONSTANT: PTP-VERSION-1 1
CONSTANT: PTP-VERSION-2 2
CONSTANT: PTP-VERSION-2-1 2

! Message Type Codes (Lower 4 bits of first header octet)
CONSTANT: MSG-SYNC                  0x0
CONSTANT: MSG-DELAY-REQ             0x1
CONSTANT: MSG-PDELAY-REQ            0x2
CONSTANT: MSG-PDELAY-RESP           0x3
CONSTANT: MSG-FOLLOW-UP             0x8
CONSTANT: MSG-DELAY-RESP            0x9
CONSTANT: MSG-PDELAY-RESP-FOLLOW-UP 0xA
CONSTANT: MSG-ANNOUNCE              0xB
CONSTANT: MSG-SIGNALING             0xC
CONSTANT: MSG-MANAGEMENT            0xD

! Header Flag Bit Masks (16-bit uint16)
CONSTANT: FLAG-PTP-SECURITY               0x0001
CONSTANT: FLAG-PTP-PROFILE-SPECIFIC-2     0x0002
CONSTANT: FLAG-PTP-PROFILE-SPECIFIC-1     0x0004
CONSTANT: FLAG-PTP-UNICAST                0x0400
CONSTANT: FLAG-PTP-TWO-STEP               0x0200
CONSTANT: FLAG-PTP-ALTERNATE-MASTER       0x0100
CONSTANT: FLAG-FREQUENCY-TRACEABLE        0x0020
CONSTANT: FLAG-TIME-TRACEABLE             0x0010
CONSTANT: FLAG-PTP-TIMESCALE              0x0008
CONSTANT: FLAG-PTP-TIME-SLAVE             0x0004
CONSTANT: FLAG-LEAP-59                    0x0002
CONSTANT: FLAG-LEAP-61                    0x0001

! Standard Clock Classes per IEEE 1588 Clause 7.6.2.4
CONSTANT: CLOCK-CLASS-PRIMARY-REF         6   ! GNSS / Atomic clock
CONSTANT: CLOCK-CLASS-HOLDOVER            7   ! High-spec holdover
CONSTANT: CLOCK-CLASS-DEGRADED-1          13
CONSTANT: CLOCK-CLASS-DEGRADED-2          52
CONSTANT: CLOCK-CLASS-DEFAULT             248 ! Free-running default clock
CONSTANT: CLOCK-CLASS-SLAVE-ONLY          255 ! Slave-only ordinary clock

! Standard Clock Accuracies per IEEE 1588 Clause 7.6.2.5
CONSTANT: CLOCK-ACCURACY-25NS             0x20
CONSTANT: CLOCK-ACCURACY-100NS            0x21
CONSTANT: CLOCK-ACCURACY-250NS            0x22
CONSTANT: CLOCK-ACCURACY-1US              0x23
CONSTANT: CLOCK-ACCURACY-2-5US            0x24
CONSTANT: CLOCK-ACCURACY-10US             0x25
CONSTANT: CLOCK-ACCURACY-25US             0x26
CONSTANT: CLOCK-ACCURACY-100US            0x27
CONSTANT: CLOCK-ACCURACY-UNKNOWN          0xFE

! Time Source Codes per IEEE 1588 Clause 7.6.2.6
CONSTANT: TIME-SOURCE-ATOMIC-CLOCK        0x10
CONSTANT: TIME-SOURCE-GNSS                0x20
CONSTANT: TIME-SOURCE-TERRESTRIAL-RADIO   0x30
CONSTANT: TIME-SOURCE-SERIAL-PTP          0x40
CONSTANT: TIME-SOURCE-NTP                 0x50
CONSTANT: TIME-SOURCE-INTERNAL-OSCILLATOR 0xA0

! Delay Measurement Mechanisms
CONSTANT: DELAY-MECH-E2E                  1   ! End-to-End (Delay_Req / Delay_Resp)
CONSTANT: DELAY-MECH-P2P                  2   ! Peer-to-Peer (Pdelay_Req / Pdelay_Resp)
CONSTANT: DELAY-MECH-DISABLED             254

! Standard Packet Sizes in Octets
CONSTANT: PTP-HEADER-LENGTH               34
CONSTANT: PTP-SYNC-LENGTH                 44
CONSTANT: PTP-FOLLOW-UP-LENGTH            44
CONSTANT: PTP-DELAY-REQ-LENGTH            44
CONSTANT: PTP-DELAY-RESP-LENGTH           54
CONSTANT: PTP-PDELAY-REQ-LENGTH           54
CONSTANT: PTP-PDELAY-RESP-LENGTH          54
CONSTANT: PTP-PDELAY-RESP-FOLLOW-UP-LENGTH 54
CONSTANT: PTP-ANNOUNCE-BASE-LENGTH        64
CONSTANT: PTP-SIGNALING-BASE-LENGTH       44
CONSTANT: PTP-MANAGEMENT-BASE-LENGTH      48
